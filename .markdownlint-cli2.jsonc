{
  // Tables and ADR prose use long lines on purpose; the pull request template starts at level 2.
  "config": {
    "MD013": false,
    "MD041": false,
    // The changelog repeats "Added", "Fixed" and so on under every version (Keep a Changelog).
    "MD024": { "siblings_only": true }
  },
  // Planning documents keep their original languages and format; CLAUDE.md is maintainer-owned.
  "ignores": [
    "**/node_modules/**",
    ".venv/**",
    "**/.next/**",
    "**/test-results/**",
    "**/playwright-report/**",
    "CLAUDE.md",
    "PHAROS_MASTER_PROMPT.md",
    "docs/PLAN.md",
    "docs/ARCHITECTURE_PROPOSAL.md"
  ]
}
