# Copy to deploy/.env and replace every value. deploy/.env is git-ignored; never commit it.
# All values below are fake placeholders. Milestone M1-08 extends this file for the full stack.

# Defaults to production when unset. Production refuses placeholder database passwords and
# requires a Redis password. Use "development" only on a developer machine.
PHAROS_ENVIRONMENT=development
PHAROS_LOG_LEVEL=INFO

# Web app: the language shown when a visitor's browser language is not supported
# (en, az, tr or ru; anything else falls back to en). Read at runtime, so no rebuild is needed.
PHAROS_DEFAULT_LOCALE=en

# API and worker connect as pharos_app, which does not own the tables, so row-level security applies.
PHAROS_DATABASE_URL=postgresql+asyncpg://pharos_app:change-me@postgres:5432/pharos
PHAROS_REDIS_URL=redis://:change-me@redis:6379/0

# Used only by the one-shot migration job, never by the API or worker processes.
# The pharos_app and pharos_owner roles must exist before migrating (docs/DATA_MODEL.md#database-roles).
PHAROS_MIGRATIONS_DATABASE_URL=postgresql+asyncpg://pharos_owner:change-me@postgres:5432/pharos
