# Copy to deploy/.env (or run `make env`, which also generates the passwords) and replace every
# value. deploy/.env is git-ignored; never commit it. Everything below is a fake placeholder.

# --- Secrets -----------------------------------------------------------------------------------
# Use URL-safe characters only, for example the output of `openssl rand -hex 24`: the passwords are
# placed inside connection URLs. Production refuses the placeholder "change-me".
POSTGRES_PASSWORD=change-me
PHAROS_OWNER_PASSWORD=change-me
PHAROS_APP_PASSWORD=change-me
# The worker and the scheduler get their own database role with grants on the ingestion tables only.
# A database created before this variable existed has no such role: recreate its volume (see
# docs/DEPLOYMENT.md).
PHAROS_WORKER_DB_PASSWORD=change-me
PHAROS_REDIS_PASSWORD=change-me
# A second, different password: the worker and the scheduler get their own Redis user that cannot
# read sessions or sign-in state (deploy/redis/start.sh).
PHAROS_REDIS_WORKER_PASSWORD=change-me
# Root secret for tokens and hashes (at least 32 random bytes; `make env` generates one). Changing it
# signs everyone out and invalidates audit-log IP hashes.
PHAROS_SECRET_KEY=change-me

# --- Site --------------------------------------------------------------------------------------
# The host name users open, and how TLS is obtained: "internal" (Caddy's own CA, default), an
# e-mail address for an automatic certificate on a public domain, or "cert.pem key.pem" paths.
PHAROS_DOMAIN=localhost
PHAROS_TLS=internal
# Host ports. Change them when 80 or 443 is already taken.
PHAROS_HTTP_PORT=80
PHAROS_HTTPS_PORT=443
# The address users open, exactly as in the browser (scheme, host and a port other than 443). The
# API uses it for redirects and to reject requests from other origins. Production needs https.
PHAROS_PUBLIC_URL=https://localhost
# The internal `app` network and Caddy's fixed address on it. Only change them when the range clashes
# with a network on this host. Caddy's address lies inside the subnet but outside the dynamic range.
# PHAROS_APP_SUBNET=172.28.20.0/24
# PHAROS_APP_DYNAMIC_RANGE=172.28.20.0/25  # where other containers get addresses
# PHAROS_CADDY_IP=172.28.20.254
# Password sign-in: break-glass (administrators only, the default), on (everyone) or off.
PHAROS_LOCAL_LOGIN=break-glass
# Single sign-on with an OpenID Connect provider (leave empty for password sign-in only). The issuer
# and the client id switch it on; production needs https and the client secret. Register
# <PHAROS_PUBLIC_URL>/api/auth/oidc/callback as the redirect URI at the provider.
# Also register <PHAROS_PUBLIC_URL>/login as the post-logout redirect URI if the provider asks.
# Microsoft Entra ID: set PHAROS_OIDC_PRESET=entra, PHAROS_ENTRA_TENANT_ID (the directory id, a
# GUID; "common" and domain names are refused) and the client id and secret; leave the issuer empty.
# PHAROS_OIDC_PRESET=generic
# PHAROS_ENTRA_TENANT_ID=
# Guests invited from another directory are refused unless this is true.
# PHAROS_ENTRA_ALLOW_GUESTS=false
PHAROS_OIDC_ISSUER=
PHAROS_OIDC_CLIENT_ID=
PHAROS_OIDC_CLIENT_SECRET=
# PHAROS_OIDC_SCOPES=openid profile email
# PHAROS_OIDC_PROVIDER_NAME=Single sign-on
# PHAROS_OIDC_DEPARTMENT_CLAIM=department
# Short name of the organization this installation serves. Create it once the stack is up.
PHAROS_ORG_SLUG=default

# Optional. A fine-grained GitHub token with no scopes and no repository access; it only raises
# the API rate limit for GitHub release sources from 60 to 5000 requests an hour. Only the worker
# receives it, and it is only ever sent to api.github.com.
PHAROS_GITHUB_TOKEN=

# --- Application -------------------------------------------------------------------------------
# Unset means production. Production refuses placeholder passwords and serves no API docs.
PHAROS_ENVIRONMENT=production
PHAROS_LOG_LEVEL=INFO
# The language shown when a visitor's browser language is not supported: en, az, tr or ru.
PHAROS_DEFAULT_LOCALE=en
# true applies database migrations before the API starts (convenient for a first install).
# Set false in production and apply each migration yourself after reviewing it:
#   docker compose --env-file deploy/.env -f deploy/docker-compose.yml run --rm -e PHAROS_MIGRATE_ON_START=true migrate
PHAROS_MIGRATE_ON_START=true
# Tag of the locally built images. Leave it alone; the Compose test uses its own tag.
# PHAROS_IMAGE_TAG=local

# --- Running the backend outside Docker (uv run uvicorn ...) -----------------------------------
# PHAROS_ENVIRONMENT=development
# PHAROS_DATABASE_URL=postgresql+asyncpg://pharos_app:<password>@localhost:5432/pharos
# PHAROS_REDIS_URL=redis://:<password>@localhost:6379/0
# PHAROS_MIGRATIONS_DATABASE_URL=postgresql+asyncpg://pharos_owner:<password>@localhost:5432/pharos
