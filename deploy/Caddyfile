# Edge proxy: TLS, /api to the backend, everything else to the web app.
#
# PHAROS_DOMAIN  the host name users open (default: localhost)
# PHAROS_TLS     "internal"   a certificate from Caddy's own CA (default; browsers warn until the
#                             CA is trusted). Also the right choice for private networks.
#                an e-mail    automatic Let's Encrypt/ZeroSSL certificate for a public domain
#                "cert key"   paths of your own certificate and key, mounted into the container

{
	# The admin API is not needed and is not exposed.
	admin off

	# The automatic HTTP-to-HTTPS redirect reflects the request's Host header and leaves out a
	# non-default HTTPS port; the explicit redirect below replaces it.
	auto_https disable_redirects

	# Caddy listens on the same port numbers the host publishes (see docker-compose.yml). A browser
	# and another container then use one address, and the HTTP-to-HTTPS redirect names the right port.
	http_port {$PHAROS_HTTP_PORT:80}
	https_port {$PHAROS_HTTPS_PORT:443}
}

# Container health check, reachable on the internal network only (the port is not published).
http://:2020 {
	respond "ok" 200
}

# Optional extra sites, for example the development identity provider (docker-compose.sso-dev.yml).
# The directory is empty unless an override file mounts something into it.
import /etc/caddy/conf.d/*.caddy

# HTTP to HTTPS, for any Host header. The target is the configured domain, never the request's
# Host header (no open redirect). ACME HTTP challenges are answered before this site is reached.
http://:{$PHAROS_HTTP_PORT:80} {
	redir https://{$PHAROS_DOMAIN:localhost}:{$PHAROS_HTTPS_PORT:443}{uri} 308
}

{$PHAROS_DOMAIN:localhost} {
	tls {$PHAROS_TLS:internal}

	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
	}

	# /readyz opens database and Redis connections and needs no login, so it is not served to the
	# internet. The container health checks and operators reach it on the internal network.
	# This block must come before "handle /api/*": handle blocks are tried in the order written,
	# and a plain "respond" directive would run after the proxy has already answered.
	@readyz path /api/readyz
	handle @readyz {
		respond 404
	}

	handle /api/* {
		reverse_proxy api:8000 {
			# The client must not choose its own request id.
			header_up X-Request-ID {http.request.uuid}
		}
	}

	handle {
		reverse_proxy web:3000
	}
}
