#!/usr/bin/env bash
# Git pre-commit hook: scan staged changes for secrets with gitleaks (run in Docker, no host install).
# Enable with: make hooks
#
# It fails closed: a scan that could not read the repository blocks the commit. In a linked worktree
# `.git` is a file that points into the main repository's `.git`, so that directory is mounted too,
# at the same path, or gitleaks finds no repository, says "no leaks found" and scans nothing.
set -eu
image="zricethezav/gitleaks@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f" # v8.30.1

if ! command -v docker >/dev/null 2>&1; then
  echo "pre-commit: docker is required for the gitleaks scan; commit blocked." >&2
  exit 1
fi

repo=$(git rev-parse --show-toplevel)
common=$(git rev-parse --path-format=absolute --git-common-dir)
mounts=(-v "$repo:$repo:ro")
case "$common/" in "$repo"/*) ;; *) mounts+=(-v "$common:$common:ro") ;; esac

status=0
output=$(docker run --rm "${mounts[@]}" "$image" git --pre-commit --staged --redact --verbose "$repo" 2>&1) || status=$?
printf '%s\n' "$output"
if [ "$status" -ne 0 ]; then
  exit "$status"
fi
# gitleaks reports a repository it cannot read as an error but still exits 0.
if grep -q 'ERR' <<<"$output" || ! grep -q 'no leaks found' <<<"$output"; then
  echo "pre-commit: the gitleaks scan did not run cleanly (see above); commit blocked." >&2
  exit 1
fi
