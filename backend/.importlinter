[importlinter]
root_package = pharos
include_external_packages = True

[importlinter:contract:services-do-not-import-fastapi]
name = Services do not import FastAPI
type = forbidden
source_modules =
    pharos.*.service
forbidden_modules =
    fastapi
    starlette
# Only direct imports count: a service may use shared infrastructure that itself uses FastAPI.
allow_indirect_imports = True

[importlinter:contract:routers-do-not-touch-repositories]
name = Routers go through services, never repositories
type = forbidden
source_modules =
    pharos.*.router
forbidden_modules =
    pharos.*.repository
# router -> service -> repository is the intended chain, so indirect imports are fine.
allow_indirect_imports = True

[importlinter:contract:httpx-only-in-the-identity-provider-client]
name = Only two modules import httpx (ADR-0011, ADR-0012)
type = forbidden
source_modules =
    pharos
forbidden_modules =
    httpx
    httpcore
ignore_imports =
    pharos.identity.oidc.client -> httpx
    pharos.net.safe_http -> httpx
    pharos.net.safe_http -> httpcore
# The fixture projects of test_import_contracts.py do not contain that module.
unmatched_ignore_imports_alerting = none

[importlinter:contract:api-does-not-fetch]
name = API modules never import the fetcher (ADR-0012)
type = forbidden
source_modules =
    pharos.*.router
    pharos.*.service
forbidden_modules =
    pharos.net.safe_http
allow_indirect_imports = True
unmatched_ignore_imports_alerting = none

[importlinter:contract:sources-api-has-no-network]
name = The sources API never loads anything that fetches (M3-10)
type = forbidden
source_modules =
    pharos.sources
    pharos.items
    pharos.feeds
forbidden_modules =
    pharos.net.safe_http
    pharos.ingest.fetcher
    pharos.ingest.connectors
    pharos.workers
    pharos.core.queue
    httpx
    httpcore
# No allow_indirect_imports: a module the API imports must not import the HTTP client either.

[importlinter:contract:sources-open-no-connections-themselves]
name = The sources API opens no connections itself (M3-10)
type = forbidden
source_modules =
    pharos.sources
    pharos.items
    pharos.feeds
forbidden_modules =
    requests
    urllib3
    aiohttp
    urllib
    http
    socket
    ftplib
    smtplib
    celery
    kombu
# Direct imports only: the framework below it uses sockets and the standard `http` package.
allow_indirect_imports = True

[importlinter:contract:ingestion-has-no-network-of-its-own]
name = Ingestion reaches the network only through SafeHttpClient
type = forbidden
source_modules =
    pharos.ingest
forbidden_modules =
    requests
    urllib3
    aiohttp
    urllib
    http
    socket
    ftplib
    smtplib
ignore_imports =
    # Splitting and joining addresses (urllib.parse) opens no connection.
    pharos.ingest.links -> urllib
    pharos.ingest.pipeline -> urllib
    pharos.ingest.connectors.rss -> urllib
    pharos.ingest.connectors.hackernews -> urllib
    pharos.ingest.sourceconfig -> urllib
# The feed parser may use the standard library inside itself; only direct imports are forbidden here.
allow_indirect_imports = True
unmatched_ignore_imports_alerting = none

[importlinter:contract:litellm-in-one-module]
name = Only one module imports LiteLLM (ADR-0002, ADR-0015)
type = forbidden
source_modules =
    pharos
forbidden_modules =
    litellm
ignore_imports =
    pharos.llm.litellm_provider -> litellm
# The fixture projects of test_import_contracts.py do not contain that module.
unmatched_ignore_imports_alerting = none

[importlinter:contract:llm-is-not-an-api-module]
name = The API never imports the model layer's providers (ADR-0004)
type = forbidden
source_modules =
    pharos.*.router
    pharos.*.service
    pharos.main
forbidden_modules =
    pharos.llm.litellm_provider
    pharos.llm.factory
    pharos.llm.gateway
allow_indirect_imports = True
unmatched_ignore_imports_alerting = none

[importlinter:contract:corpus-door-has-one-user]
name = Only the evaluation runner uses the corpus door (M4-09)
type = forbidden
source_modules =
    pharos.*
forbidden_modules =
    pharos.llm.corpus_door
ignore_imports =
    pharos.evaluation.runner -> pharos.llm.corpus_door
unmatched_ignore_imports_alerting = none

[importlinter:contract:evaluation-has-no-network]
name = The evaluation opens no connection of its own (M4-09)
type = forbidden
source_modules =
    pharos.evaluation
forbidden_modules =
    pharos.net
    httpx
    httpcore
    requests
    socket
    aiohttp
allow_indirect_imports = True
unmatched_ignore_imports_alerting = none

# Still to add when the modules exist:
# - a module never imports another module's repository (one contract per module pair or a layers
#   contract over the module list, once there is more than one module with a repository);
# - litellm may only be imported inside pharos.llm (ADR-0002, with M4).
